[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%Provider%
CatalogFile=AImerVirtualMouse.cat
DriverVer=09/28/2026,1.0.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceName%=Mouse,Root\AImerVirtualMouse

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
AImerVirtualMouse.sys=1

[Mouse.NT]
CopyFiles=DriverCopy

[DriverCopy]
AImerVirtualMouse.sys

[Mouse.NT.HW]
AddReg=Mouse.Hardware

[Mouse.Hardware]
HKR,,LowerFilters,0x00010000,"vhf"
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Mouse.NT.Services]
AddService=AImerVirtualMouse,0x00000002,Mouse.Service

[Mouse.Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\AImerVirtualMouse.sys

[Mouse.NT.Wdf]
KmdfService=AImerVirtualMouse,Mouse.Wdf

[Mouse.Wdf]
KmdfLibraryVersion=1.15

[Strings]
Provider="AImer"
DeviceName="AImer Virtual HID Mouse"
DiskName="AImer Virtual HID Mouse Installation"
